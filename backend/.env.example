# MathKnights Backend Environment Configuration
# Copy this to .env and fill in your values

# ─── DeepSeek API ─────────────────────────────────────────────────────
# Used for LLM grading, dynamic problem generation, and OCR image parsing.
# If DEEPSEEK_API_KEY is empty, grading falls back to simple keyword matching.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Vision model for OCR image recognition (defaults to DEEPSEEK_MODEL if unset)
DEEPSEEK_VISION_MODEL=deepseek-chat

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./mathknights.db

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Defaults to localhost dev servers (5173, 8080, 3000) when unset.
# CORS_ORIGINS=http://localhost:8080,https://your-production-domain.com
